<?xml version="1.0" encoding="UTF-8"?>
<TestCaseResult CasePath="dEQP-GLES31.functional.draw_indirect.compute_interop.combined.drawarrays_compute_cmd_and_data" Version="0.3.4" CaseType="SelfValidate">
 <ShaderProgram LinkStatus="OK">
  <InfoLog></InfoLog>
  <ComputeShader CompileStatus="OK">
   <ShaderSource>#version 310 es

precision highp int;
precision highp float;

struct DrawArraysIndirectCommand {
    uint count;
    uint primCount;
    uint first;
    uint reservedMustBeZero;
};

layout(local_size_x = 1, local_size_y = 1) in;
layout(std430) buffer;

layout(binding = 0) writeonly buffer CommandBuffer {
    DrawArraysIndirectCommand commands[];
};
layout(binding = 1) writeonly buffer DataBuffer {
    vec4 attribs[];
};

void main() {
    const uint gridSize      = 8u;
    const uint triangleCount = gridSize * gridSize * 2u;

    // command
    if (gl_GlobalInvocationID.x &lt; 1u &amp;&amp; gl_GlobalInvocationID.y == 0u &amp;&amp; gl_GlobalInvocationID.z == 0u) {
        const uint numDrawCallTris = triangleCount / 1u;
        uint firstTri              = gl_GlobalInvocationID.x * numDrawCallTris;

        commands[gl_GlobalInvocationID.x].count                 = numDrawCallTris*3u;
        commands[gl_GlobalInvocationID.x].primCount             = 1u;
        commands[gl_GlobalInvocationID.x].first                 = firstTri*3u;
        commands[gl_GlobalInvocationID.x].reservedMustBeZero    = 0u;
    }

    // vertex attribs
    const vec4 yellow = vec4(1.0, 1.0, 0.0, 1.0);
    const vec4 green = vec4(0.0, 1.0, 0.0, 1.0);
    if (gl_GlobalInvocationID.x &lt; gridSize &amp;&amp; gl_GlobalInvocationID.y &lt; gridSize &amp;&amp; gl_GlobalInvocationID.z == 0u) {
        uint        y           = gl_GlobalInvocationID.x;
        uint        x           = gl_GlobalInvocationID.y;
        float       posX        = (float(x)    / float(gridSize)) * 2.0 - 1.0;
        float       posXp1      = (float(x+1u) / float(gridSize)) * 2.0 - 1.0;
        float       posY        = (float(y)    / float(gridSize)) * 2.0 - 1.0;
        float       posYp1      = (float(y+1u) / float(gridSize)) * 2.0 - 1.0;
        vec4        color       = ((x + y)%2u != 0u) ? (yellow) : (green);

        attribs[((y * gridSize + x) * 6u + 0u) * 2u + 0u] = vec4(posX,   posY,   0.0, 1.0);
        attribs[((y * gridSize + x) * 6u + 1u) * 2u + 0u] = vec4(posXp1, posY,   0.0, 1.0);
        attribs[((y * gridSize + x) * 6u + 2u) * 2u + 0u] = vec4(posXp1, posYp1, 0.0, 1.0);
        attribs[((y * gridSize + x) * 6u + 3u) * 2u + 0u] = vec4(posX,   posY,   0.0, 1.0);
        attribs[((y * gridSize + x) * 6u + 4u) * 2u + 0u] = vec4(posXp1, posYp1, 0.0, 1.0);
        attribs[((y * gridSize + x) * 6u + 5u) * 2u + 0u] = vec4(posX,   posYp1, 0.0, 1.0);

        attribs[((y * gridSize + x) * 6u + 0u) * 2u + 1u] = color;
        attribs[((y * gridSize + x) * 6u + 1u) * 2u + 1u] = color;
        attribs[((y * gridSize + x) * 6u + 2u) * 2u + 1u] = color;
        attribs[((y * gridSize + x) * 6u + 3u) * 2u + 1u] = color;
        attribs[((y * gridSize + x) * 6u + 4u) * 2u + 1u] = color;
        attribs[((y * gridSize + x) * 6u + 5u) * 2u + 1u] = color;
    }

}
</ShaderSource>
