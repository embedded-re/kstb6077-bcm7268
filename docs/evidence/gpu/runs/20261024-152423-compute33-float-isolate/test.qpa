   <ShaderSource>#version 310 es
layout (local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
const uint LOCAL_SIZE = gl_WorkGroupSize.x*gl_WorkGroupSize.y*gl_WorkGroupSize.z;
shared highp float s_var;
uniform highp float u_val[15];
uniform highp float u_ref[15];
uniform uint u_numIters;
layout(binding = 0) buffer Result
{
    bool isOk[LOCAL_SIZE];
};

void main (void)
{
    bool allOk = true;
    for (uint ndx = 0u; ndx &lt; u_numIters; ndx++)
    {
        if (ndx == gl_LocalInvocationIndex)
            s_var = u_val[ndx%uint(u_val.length())];

        barrier();

        if (s_var != u_ref[ndx%uint(u_ref.length())])
            allOk = false;

        barrier();
    }

    isOk[gl_LocalInvocationIndex] = allOk;
}
</ShaderSource>
