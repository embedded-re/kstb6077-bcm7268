# busybox init: root shells on the serial console and on the HDMI console (tty1)
::sysinit:/etc/kstb-rc
# services on ROOT (kstb-setup): OpenRC after kstb-rc. 'once' does not hold
# up the shells, so a service that hangs can't lock out the consoles.
# The initramfs has no OpenRC and skips these.
::sysinit:/bin/sh -c '[ ! -x /sbin/openrc ] || exec /sbin/openrc sysinit'
::once:/bin/sh -c '[ ! -x /sbin/openrc ] || { /sbin/openrc boot; exec /sbin/openrc default; }'
ttyS0::respawn:/sbin/getty -n -l /usr/sbin/kstb-console 115200 ttyS0 vt100
tty1::respawn:/sbin/getty -n -l /usr/sbin/kstb-console 38400 tty1 linux
::ctrlaltdel:/sbin/reboot
::shutdown:/bin/sh -c '[ ! -x /sbin/openrc ] || exec /sbin/openrc shutdown'
::shutdown:/bin/umount -a -r
