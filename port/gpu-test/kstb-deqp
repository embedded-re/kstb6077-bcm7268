#!/usr/bin/env python3
"""Run dEQP (GLES2, GLES3, GLES31, EGL) on the box, a chunk of cases per process,
resumable: a crash, a GPU hang or a reset of the whole board loses at most
the case that was running.

    kstb-deqp gles2 [--cases FILE] [--filter PREFIX] [--chunk 500] [--timeout 120]
    kstb-deqp gles2 --summary

DEQP (default /root/deqp) holds gles2/deqp-gles2 with its data directory
gles2/gles2, the same for gles3, gles31 and egl, and mustpass/<module>-main.txt
(port/README.md, "dEQP"). Results go to $DEQP/results-<module>.txt, one
line per case: "<case> <result> <detail>". The case that was running when
the board went down is in $DEQP/running-<module>; the next run records it
as "Lost" and goes on after it.
"""
import argparse, collections, os, re, select, subprocess, sys, time

DEQP = os.environ.get("DEQP", "/root/deqp")
BIN = {"gles2": "deqp-gles2", "gles3": "deqp-gles3",
       "gles31": "deqp-gles31", "egl": "deqp-egl"}
ARGS = ["--deqp-surface-type=" + os.environ.get("DEQP_SURFACE_TYPE", "pbuffer"),
        "--deqp-gl-config-name=rgba8888d24s8ms0",
        "--deqp-surface-width=256", "--deqp-surface-height=256",
        "--deqp-log-images=disable", "--deqp-log-shader-sources=disable",
        "--deqp-log-filename=/dev/null", "--deqp-watchdog=enable"]
CASE = re.compile(r"^Test case '([^']+)'\.\.")
RESULT = re.compile(r"^  (Pass|Fail|NotSupported|QualityWarning|CompatibilityWarning|"
                    r"InternalError|ResourceError|Crash|Timeout|Waiver|DeviceLost)\b ?(.*)")


def fsync_write(path, text):
    with open(path, "w") as f:
        f.write(text)
        f.flush()
        os.fsync(f.fileno())


def load_results(path):
    done = {}
    if os.path.exists(path):
        for line in open(path):
            parts = line.rstrip("\n").split(" ", 2)
            if len(parts) >= 2:
                done[parts[0]] = parts[1]
    return done


def summary(results):
    counts = {}
    for r in load_results(results).values():
        counts[r] = counts.get(r, 0) + 1
    total = sum(counts.values())
    print(f"{total} cases: " + ", ".join(f"{k} {v}" for k, v in sorted(counts.items(), key=lambda x: -x[1])))


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("module", choices=sorted(BIN))
    ap.add_argument("--cases", help="case list (default mustpass/<module>-main.txt)")
    ap.add_argument("--filter", default="", help="only cases starting with this")
    ap.add_argument("--chunk", type=int, default=500)
    ap.add_argument("--timeout", type=int, default=120, help="seconds without output before a kill")
    ap.add_argument("--summary", action="store_true")
    a = ap.parse_args()

    mod = a.module
    results = os.path.join(DEQP, f"results-{mod}.txt")
    running = os.path.join(DEQP, f"running-{mod}")
    if a.summary:
        summary(results)
        return
    cases = [c.strip() for c in open(a.cases or os.path.join(DEQP, "mustpass", f"{mod}-main.txt"))
             if c.strip() and c.startswith(a.filter)]
    done = load_results(results)
    out = open(results, "a")
    if os.path.exists(running):        # the board went down during this case
        lost = open(running).read().strip()
        if lost and lost not in done:
            out.write(f"{lost} Lost board reset or hang\n")
            done[lost] = "Lost"
        os.remove(running)
    todo = [c for c in cases if c not in done]
    print(f"{mod}: {len(cases)} cases, {len(cases) - len(todo)} done before, {len(todo)} to run", flush=True)
    env = dict(os.environ, EGL_PLATFORM=os.environ.get("DEQP_EGL_PLATFORM", "surfaceless"),
               MESA_SHADER_CACHE_DISABLE="true")
    wd = os.path.join(DEQP, mod)
    t0 = time.time()
    ran = 0
    while todo:
        chunk, todo = todo[:a.chunk], todo[a.chunk:]
        listfile = os.path.join(DEQP, f"chunk-{mod}.txt")
        fsync_write(listfile, "\n".join(chunk) + "\n")
        p = subprocess.Popen([os.path.join(wd, BIN[mod]), f"--deqp-caselist-file={listfile}"] + ARGS,
                             cwd=wd, env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
        current, seen, buf = None, set(), b""
        tail = collections.deque(maxlen=40)
        fd = p.stdout.fileno()
        last = time.time()
        while True:
            r, _, _ = select.select([fd], [], [], 5)
            if not r:
                if time.time() - last > a.timeout:
                    p.kill()
                    break
                continue
            data = os.read(fd, 65536)
            if not data:
                break
            last = time.time()
            buf += data
            *lines, buf = buf.split(b"\n")
            for line in lines:
                line = line.decode("utf-8", "replace")
                tail.append(line)
                m = CASE.match(line)
                if m:
                    current = m.group(1)
                    fsync_write(running, current + "\n")
                    continue
                m = RESULT.match(line)
                if m and current:
                    out.write(f"{current} {m.group(1)} @uptime={time.monotonic():.3f} "
                              f"{m.group(2).strip()}\n")
                    out.flush()             # a killed runner loses nothing
                    seen.add(current)
                    ran += 1
                    current = None
        rc = p.wait()
        if not seen and not current:
            diagnostic = "\n".join(tail) + "\n" + buf.decode("utf-8", "replace")
            sys.exit(f"{BIN[mod]} ran no case (exit {rc}):\n{diagnostic[-6000:]}")
        if current and current not in seen:     # died or was killed in this case
            what = "Timeout" if rc == -9 else "Crash"
            out.write(f"{current} {what} @uptime={time.monotonic():.3f} exit {rc}\n")
            seen.add(current)
            ran += 1
        out.flush()
        os.fsync(out.fileno())
        if os.path.exists(running):
            os.remove(running)
        rest = [c for c in chunk if c not in seen]
        if rest and (rc != 0 or current):
            # ResourceError can abort dEQP with a positive exit code. Cases
            # after that result still exist and must run in a fresh process.
            todo = rest + todo
        elif rest:
            for c in rest:                      # deqp skipped them (not in its tree)
                out.write(f"{c} Missing not run\n")
        el = time.time() - t0
        print(f"  {ran} run, {len(todo)} left, {el:.0f} s", flush=True)
    out.close()
    summary(results)


if __name__ == "__main__":
    main()
