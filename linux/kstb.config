# kstb.config - KSTB6077 (BCM7268) kernel: `make alldefconfig KCONFIG_ALLCONFIG=kstb.config` (upstream defaults + this).
# Only what this box uses, all built in (no modules).
CONFIG_LOCALVERSION="-kstb"
CONFIG_DEFAULT_HOSTNAME="kstb6077"
CONFIG_SYSVIPC=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_PRINTK_TIME=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_MAGIC_SYSRQ=y
# platform and CPU (Brahma-B53 = Cortex-A53 errata)
CONFIG_ARCH_BCM=y
CONFIG_ARCH_BRCMSTB=y
CONFIG_NR_CPUS=4
CONFIG_ARM64_ERRATUM_826319=y
CONFIG_ARM64_ERRATUM_827319=y
CONFIG_ARM64_ERRATUM_824069=y
CONFIG_ARM64_ERRATUM_819472=y
CONFIG_ARM64_ERRATUM_843419=y
# CONFIG_RANDOMIZE_BASE is not set
# console: UART0, 16550 with 32-bit registers
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_EARLYCON=y
# file systems
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
# network
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_INET=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_BROADCOM=y
CONFIG_BCMGENET=y
CONFIG_PHYLIB=y
CONFIG_BCM7XXX_PHY=y
# watchdog, eMMC, USB (described in the DTS once tried)
CONFIG_WATCHDOG=y
CONFIG_BCM7038_WDT=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_BRCMSTB=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_HID_SUPPORT=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_DEFAULT_PERSIST=y
CONFIG_USB_EHCI_HCD=y
# split transactions through a hub TT: complete-splits at Y+2..Y+4 (off in allnoconfig;
# the old scheduler's Y+1..Y+2 made the low-speed keyboard fail with missed microframes)
CONFIG_USB_EHCI_TT_NEWSCHED=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PLATFORM=y
CONFIG_USB_STORAGE=y
CONFIG_GENERIC_PHY=y
CONFIG_PHY_BRCM_USB=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
# HDMI: the 1080p RGB565 framebuffer that kmon leaves running (simplefb), text console on it
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_USB_BRCMSTB=y
# debugging: usbmon (/sys/kernel/debug/usb/usbmon), dynamic debug
CONFIG_DEBUG_FS=y
CONFIG_USB_MON=y
CONFIG_DYNAMIC_DEBUG=y
# GPIO (gpio-brcmstb, on by default with ARCH_BRCMSTB): front LEDs, SW1 (interrupt), SW4 (polled)
CONFIG_GPIO_CDEV=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_TIMER=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y
CONFIG_LEDS_TRIGGER_DEFAULT_ON=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_KEYBOARD_GPIO_POLLED=y
# I2C: the five BSC masters (i2c-brcmstb), /dev/i2c-* for i2c-tools
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_BRCMSTB=y
# temperature (AVS TMON), the wake timer as RTC (no battery: only across warm resets)
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_BRCMSTB_THERMAL=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_BRCMSTB=y
# loadable modules: our own drivers (drivers/) and the few that need files from ROOT; `make modules`
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
# IR receiver (drivers/kstb-ir.c, a module): rc-core, key events on an input device
CONFIG_RC_CORE=y
CONFIG_LIRC=y
# defaults that become =m with MODULES: not used here (no RNG the host can reach, no EFI)
# CONFIG_HW_RANDOM is not set
# CONFIG_BCM2712_MIP is not set
# CONFIG_EFIVAR_FS is not set
# PCIe (pcie-brcmstb); Wi-Fi BCM43570 behind it: brcmfmac as a module, since it
# loads its firmware from ROOT (/lib/firmware, linux-firmware-brcm)
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCIE_BRCMSTB=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_CFG80211=m
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_PCIE=y
# Alpine's linux-firmware packages are zstd-compressed
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
# Bluetooth: the BCM43570's BT side on the internal USB port (OHCI0), btusb with
# Broadcom patchram; modules, since the patch file comes from ROOT
CONFIG_BT=m
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=m
CONFIG_BT_HIDP=m
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIBTUSB_BCM=y
CONFIG_RFKILL=y
# xHCI (xhci-plat)
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
