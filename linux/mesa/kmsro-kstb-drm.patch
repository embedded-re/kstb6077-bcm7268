kmsro: kstb-drm, the KSTB6077's HDMI display driver (linux/drivers/kstb-drm.c)

The DRI loader opens <kernel driver name>_dri.so for a KMS device; for a
display-only driver that is the megadriver's kmsro part, which pairs it with
the render GPU (v3d here). Add kstb-drm to kmsro's list of names and its
entry point.

--- a/src/gallium/targets/dri/meson.build
+++ b/src/gallium/targets/dri/meson.build
@@ -78,6 +78,7 @@
                'imx-lcdif_dri.so',
                'ingenic-drm_dri.so',
                'kirin_dri.so',
+               'kstb-drm_dri.so',
                'komeda_dri.so',
                'mali-dp_dri.so',
                'mcde_dri.so',
--- a/src/gallium/targets/dri/target.c
+++ b/src/gallium/targets/dri/target.c
@@ -108,6 +108,7 @@
 DEFINE_LOADER_DRM_ENTRYPOINT(imx_lcdif)
 DEFINE_LOADER_DRM_ENTRYPOINT(ingenic_drm)
 DEFINE_LOADER_DRM_ENTRYPOINT(kirin)
+DEFINE_LOADER_DRM_ENTRYPOINT(kstb_drm)
 DEFINE_LOADER_DRM_ENTRYPOINT(komeda)
 DEFINE_LOADER_DRM_ENTRYPOINT(mali_dp)
 DEFINE_LOADER_DRM_ENTRYPOINT(mcde)
