+/* Before V3D 4.x, ldunif can only write r5, which holds a single value: two
+ * uniforms that are live at the same time (the two sources of one
+ * instruction, as in the clear shader's "vfpack tlb, unif, unif") can't be
+ * allocated. Copy each ldunif result out of r5 in the next instruction and
+ * read the copy everywhere, so r5 is only live for that one move.
+ */
+static void
+v3d33_vir_copy_ldunifs(struct v3d_compile *c)
+{
+        if (c->devinfo->ver >= 40)
+                return;
+
+        uint32_t num_temps = c->num_temps;
+        uint32_t *copy = rzalloc_array(c, uint32_t, num_temps);
+        struct vir_cursor cursor = c->cursor;
+
+        vir_for_each_block(block, c) {
+                vir_for_each_inst_safe(inst, block) {
+                        if (!inst->qpu.sig.ldunif ||
+                            inst->dst.file != QFILE_TEMP)
+                                continue;
+                        c->cursor = vir_after_inst(inst);
+                        copy[inst->dst.index] = vir_MOV(c, inst->dst).index + 1;
+                }
+        }
+
+        vir_for_each_inst_inorder(inst, c) {
+                for (int i = 0; i < vir_get_nsrc(inst); i++) {
+                        struct qreg *src = &inst->src[i];
+
+                        if (src->file != QFILE_TEMP || src->index >= num_temps ||
+                            !copy[src->index])
+                                continue;
+                        /* the copy itself keeps reading r5 */
+                        if (inst->dst.file == QFILE_TEMP &&
+                            inst->dst.index == copy[src->index] - 1)
+                                continue;
+                        src->index = copy[src->index] - 1;
+                }
+        }
+
+        ralloc_free(copy);
+        c->cursor = cursor;
+}
