                         uniforms.bo->offset + uniforms.offset, 0,0,0,0,
                         cl->offset + 0x800, 0x2096, 4,
                         cl->offset + 0x900, 0x209a, 0,
@@ -1544,7 +1551,7 @@ v3d33_launch_grid(struct pipe_context *pctx, const struct pipe_grid_info *info)
                 uint16_t *xy = (void *)(map + 0x800);
                 for (unsigned i = 0; i < groups; i++) {
                         xy[i*4] = 128; xy[i*4+1] = 256 + 512*i;
-                        xy[i*4+2] = 64*256+128; xy[i*4+3] = 256 + 512*i;
