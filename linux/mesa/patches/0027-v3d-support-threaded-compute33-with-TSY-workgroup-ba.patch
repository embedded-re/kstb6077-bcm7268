@@ -1432,6 +1432,7 @@ v3d33_launch_grid(struct pipe_context *pctx, const struct pipe_grid_info *info)
                         return;
                 count *= v3d->compute_num_workgroups[d];
         }
+        const unsigned line_width = align(wg_size, 16) / 2;
         for (uint64_t first = 0; first < count; first += 16) {
