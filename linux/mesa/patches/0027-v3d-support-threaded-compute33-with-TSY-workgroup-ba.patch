@@ -1535,7 +1540,9 @@ v3d33_launch_grid(struct pipe_context *pctx, const struct pipe_grid_info *info)
                 }
                 cl_emit(&rcl, END_OF_RENDERING, end);
                 uint32_t record[] = {
