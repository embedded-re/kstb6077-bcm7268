Subject: [PATCH 25/34] v3d: add opt-in render-only compute dispatch on 3.3

---
 src/broadcom/compiler/nir_to_vir.c    |  32 +++++
 src/broadcom/compiler/vir.c           |   4 +-
 src/broadcom/qpu/qpu_instr.c          |   3 +-
 src/gallium/drivers/v3d/v3d_program.c |   2 +-
 src/gallium/drivers/v3d/v3d_screen.c  |  18 ++-
 src/gallium/drivers/v3d/v3d_screen.h  |   1 +
 src/gallium/drivers/v3d/v3dx_draw.c   | 187 ++++++++++++++++++++++++++
 7 files changed, 238 insertions(+), 9 deletions(-)

diff --git a/src/broadcom/compiler/nir_to_vir.c b/src/broadcom/compiler/nir_to_vir.c
index c6130cb..8f87f98 100644
--- a/src/broadcom/compiler/nir_to_vir.c
+++ b/src/broadcom/compiler/nir_to_vir.c
@@ -4508,6 +4508,38 @@ nir_to_vir(struct v3d_compile *c)
                 }
                 break;
         case MESA_SHADER_COMPUTE:
+                if (c->devinfo->ver == 33) {
+                        /* One 128-invocation raster line per workgroup. The
+                         * integer ID tile supplies local index and WG XYZ.
+                         * Lines have one implicit varying even without inputs.
+                         */
+                        vir_NOP(c)->qpu.sig.ldvary = true;
+                        struct qreg id[4];
+                        for (unsigned i = 0; i < 4; i++) {
+                                struct qinst *read = vir_NOP(c);
+                                if (!i) {
+                                        read->qpu.sig.ldtlbu = true;
+                                        read->uniform = vir_get_uniform_index(
+                                                c, QUNIFORM_CONSTANT, 0xffffff7b);
+                                } else {
+                                        read->qpu.sig.ldtlb = true;
+                                }
+                                id[i] = vir_MOV(c, vir_reg(QFILE_MAGIC,
+                                                           V3D_QPU_WADDR_R3));
+                        }
+                        c->local_invocation_index_bits = 7;
+                        struct qreg local = vir_AND(c, id[0],
+                                                    vir_uniform_ui(c, 127));
+                        c->cs_payload[0] = vir_OR(c, id[1],
+                                vir_SHL(c, id[2], vir_uniform_ui(c, 16)));
+                        c->cs_payload[1] = vir_OR(c, id[3],
+                                vir_SHL(c, local, vir_uniform_ui(c, 25)));
+                        vir_SETMSF_dest(c, vir_nop_reg(),
+                                vir_XOR(c, vir_SHR(c, id[0],
+                                                  vir_uniform_ui(c, 15)),
+                                        vir_uniform_ui(c, 1)));
+                        break;
+                }
                 /* Set up the TSO for barriers, assuming we do some. */
                 if (c->devinfo->ver < 42) {
                         vir_BARRIERID_dest(c, vir_reg(QFILE_MAGIC,
diff --git a/src/broadcom/compiler/vir.c b/src/broadcom/compiler/vir.c
index b8146e0..ae3b1f0 100644
--- a/src/broadcom/compiler/vir.c
