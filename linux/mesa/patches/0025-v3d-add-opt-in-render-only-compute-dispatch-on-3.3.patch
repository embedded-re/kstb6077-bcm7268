                         else
@@ -489,7 +490,7 @@ v3d_get_compute_param(struct pipe_screen *pscreen, enum pipe_shader_ir ir_type,
 {
         struct v3d_screen *screen = v3d_screen(pscreen);
 
-        if (!screen->has_csd)
+        if (!screen->has_csd && !screen->has_compute33)
                 return 0;
 
 #define RET(x) do {                                     \
@@ -519,14 +520,16 @@ v3d_get_compute_param(struct pipe_screen *pscreen, enum pipe_shader_ir ir_type,
 
         case PIPE_COMPUTE_CAP_MAX_BLOCK_SIZE:
                 /* GL_MAX_COMPUTE_WORK_GROUP_SIZE */
-                RET(((uint64_t []) { 256, 256, 256 }));
+                RET(((uint64_t []) { screen->has_compute33 ? 128 : 256,
+                                    screen->has_compute33 ? 128 : 256,
+                                    screen->has_compute33 ? 128 : 256 }));
 
         case PIPE_COMPUTE_CAP_MAX_THREADS_PER_BLOCK:
         case PIPE_COMPUTE_CAP_MAX_VARIABLE_THREADS_PER_BLOCK:
                 /* GL_MAX_COMPUTE_WORK_GROUP_INVOCATIONS: This is
                  * limited by WG_SIZE in the CSD.
                  */
-                RET((uint64_t []) { 256 });
+                RET((uint64_t []) { screen->has_compute33 ? 128 : 256 });
 
         case PIPE_COMPUTE_CAP_MAX_GLOBAL_SIZE:
                 RET((uint64_t []) { 1024 * 1024 * 1024 });
@@ -1005,6 +1008,9 @@ v3d_screen_create(int fd, const struct pipe_screen_config *config,
         screen->has_csd = v3d_has_feature(screen, DRM_V3D_PARAM_SUPPORTS_CSD);
         screen->has_cache_flush =
                 v3d_has_feature(screen, DRM_V3D_PARAM_SUPPORTS_CACHE_FLUSH);
+        screen->has_compute33 = screen->devinfo.ver == 33 &&
+                screen->has_cache_flush &&
+                debug_get_bool_option("V3D_COMPUTE33", false);
         screen->has_perfmon = v3d_has_feature(screen, DRM_V3D_PARAM_SUPPORTS_PERFMON);
 
         v3d_fence_init(screen);
diff --git a/src/gallium/drivers/v3d/v3d_screen.h b/src/gallium/drivers/v3d/v3d_screen.h
index 1da9b83..74ddbfc 100644
--- a/src/gallium/drivers/v3d/v3d_screen.h
+++ b/src/gallium/drivers/v3d/v3d_screen.h
@@ -80,6 +80,7 @@ struct v3d_screen {
         uint32_t prim_types;
 
         bool has_csd;
+        bool has_compute33; /* Experimental render-only compute. */
         bool has_cache_flush;
         bool has_perfmon;
         bool nonmsaa_texture_size_limit;
diff --git a/src/gallium/drivers/v3d/v3dx_draw.c b/src/gallium/drivers/v3d/v3dx_draw.c
index a7561f3..c9c7f17 100644
--- a/src/gallium/drivers/v3d/v3dx_draw.c
+++ b/src/gallium/drivers/v3d/v3dx_draw.c
@@ -1394,6 +1394,189 @@ v3d_draw_vbo(struct pipe_context *pctx, const struct pipe_draw_info *info,
                 v3d_flush(pctx);
 }
 
+#if V3D_VERSION == 33
+/* Experimental render-only compute, deliberately separate from the CSD path.
+ * A 64x32 RGBA16UI tile supplies 16 groups of 128 invocation IDs. The NV
+ * shader record accepts raster coordinates directly, without a binner or VS.
+ */
+static void
+v3d33_launch_grid(struct pipe_context *pctx, const struct pipe_grid_info *info)
+{
+        struct v3d_context *v3d = v3d_context(pctx);
+        struct v3d_screen *screen = v3d->screen;
+        const unsigned wg_size = info->block[0] * info->block[1] * info->block[2];
+        v3d_flush(pctx);
+        v3d_predraw_check_stage_inputs(pctx, PIPE_SHADER_COMPUTE);
+        v3d_update_compiled_cs(v3d);
+        struct v3d_compiled_shader *cs = v3d->prog.compute;
+        if (!cs->resource || !wg_size || wg_size > 128 ||
+            cs->prog_data.compute->shared_size ||
+            cs->prog_data.base->has_control_barrier) {
+                fprintf(stderr, "compute33: unsupported experimental dispatch\n");
+                return;
+        }
+        if (info->indirect) {
+                struct pipe_transfer *transfer;
+                void *map = pipe_buffer_map_range(pctx, info->indirect,
+                        info->indirect_offset, 12, PIPE_MAP_READ, &transfer);
+                if (!map)
+                        return;
+                memcpy(v3d->compute_num_workgroups, map, 12);
+                pipe_buffer_unmap(pctx, transfer);
+        } else {
+                memcpy(v3d->compute_num_workgroups, info->grid, 12);
+        }
+        uint64_t count = 1;
+        for (unsigned d = 0; d < 3; d++) {
+                if (v3d->compute_num_workgroups[d] > 65535)
+                        return;
+                count *= v3d->compute_num_workgroups[d];
+        }
+        for (uint64_t first = 0; first < count; first += 16) {
+                const unsigned groups = MIN2(count - first, 16);
+                struct v3d_job *job = v3d_job_create(v3d);
+                struct v3d_bo *cl = v3d_bo_alloc(screen, 16384, "compute33_cl");
+                struct v3d_bo *ids = v3d_bo_alloc(screen, 20480, "compute33_ids");
+                struct v3d_bo *color = v3d_bo_alloc(screen, 20480, "compute33_color");
+                v3d_job_add_bo(job, cl);
+                v3d_job_add_bo(job, ids);
+                v3d_job_add_bo(job, color);
+                struct v3d_bo *code = v3d_resource(cs->resource)->bo;
+                v3d_job_add_bo(job, code);
+                struct v3d_cl_reloc uniforms = v3d_write_uniforms(v3d, job, cs,
+                                                               PIPE_SHADER_COMPUTE);
+                v3d_job_add_bo(job, uniforms.bo);
+                uint8_t *map = v3d_bo_map_unsynchronized(cl);
+                uint8_t *id_map = v3d_bo_map_unsynchronized(ids);
+                memset(map, 0, cl->size);
+                memset(id_map, 0, ids->size);
+                for (unsigned y = 0; y < groups * 2; y++) {
+                        for (unsigned x = 0; x < 64; x++) {
+                                unsigned local = (y & 1) * 64 + x;
+                                uint64_t group = first + y / 2;
+                                uint16_t id[4] = {
+                                        local | (local >= wg_size ? 0x8000 : 0),
+                                        group % v3d->compute_num_workgroups[0],
+                                        (group / v3d->compute_num_workgroups[0]) %
+                                                v3d->compute_num_workgroups[1],
+                                        group / ((uint64_t)v3d->compute_num_workgroups[0] *
+                                                 v3d->compute_num_workgroups[1]),
+                                };
+                                /* 8-byte pixels, 4x2 utiles, 8x4 UIF blocks;
+                                 * a 32-row image needs no XOR.
+                                 */
+                                unsigned off = ((x & 3) << 3) + ((y & 1) << 5) +
+                                        (((x >> 2) & 1) << 6) + (((y >> 1) & 1) << 7) +
+                                        (((((x >> 3) >> 2) * 32) + ((x >> 3) & 3) +
+                                          (y >> 2) * 4) << 8);
+                                memcpy(id_map + off, id, sizeof(id));
+                        }
+                }
+                /* Fixed render state, also exercised by the raw NV probes.
+                 * RT0 is RGBA16UI; framebuffer stores are disabled.
+                 */
+                static const uint8_t header[] = {
+                        0x79,0,0x40,0,0x20,0,0x41,0,0xff,
+                        0x79,2,0x15,0x18,4,0,0,0,0,
+                        0x79,1,4,3,0,0,0,0,0,
+                        0x79,3,0,0,0,0,0,0,0,
+                        0x0b,0x13,0x49,0x11,0x58,0x61,0x5b,0,0,0x80,0x3f,
+                        0x5c,0,0,0,0,0x69,0,0,0,0x40,
+                        0x6c,0,0,0,0,0,0,0,0,
+                        0x6d,0,0,0,0,0,0,0x80,0x3f,
+                        0x6b,0,0,0,0,0x40,0,0x20,0,0x60,1,0x70,0,
+                        0x57,0,0,0,0,
+                };
+                STATIC_ASSERT(sizeof(header) == 93);
+                memcpy(map, header, sizeof(header));
+                memcpy(map + 14, &color->offset, 4);
+                struct v3d_cl rcl = { .job = job, .bo = cl, .base = map,
+                        .size = cl->size, .next = (void *)(map + sizeof(header)) };
+                /* GFXH-1742: initialize the TLB after changing its format. */
+                cl_emit(&rcl, TILE_COORDINATES, tile);
+                cl_emit(&rcl, STORE_TILE_BUFFER_GENERAL, store) {
+                        store.buffer_to_store = NONE;
+                }
+                cl_emit(&rcl, FLUSH_VCD_CACHE, flush);
+                cl_emit(&rcl, LOAD_TILE_BUFFER_GENERAL, load) {
+                        load.address = cl_address(ids, 0);
+                        load.raw_mode = true;
+                        load.buffer_to_load = RENDER_TARGET_0;
+                        load.padded_height_of_output_image_in_uif_blocks = 8;
+                }
+                cl_emit(&rcl, TILE_COORDINATES, tile);
+                cl_emit(&rcl, PRIM_LIST_FORMAT, fmt) {
+                        fmt.primitive_type = LIST_LINES;
+                }
+                struct v3d_cl_out *r = rcl.next;
+                cl_u8(&r, 68); /* NV_SHADER_STATE */
+                cl_u32(&r, (cl->offset + 0x400) | 2);
+                const uint8_t primitives[] = {0x31,0x23,0,0,0,0,0x1b,0,0,0};
+                memcpy(r, primitives, sizeof(primitives));
+                cl_advance(&r, sizeof(primitives));
+                for (unsigned i = 1; i < groups; i++) {
+                        cl_u8(&r, 0x27); cl_u8(&r, 2);
+                }
+                cl_u8(&r, 0xe3);
+                rcl.next = r;
+                cl_emit(&rcl,
+                             STORE_MULTI_SAMPLE_RESOLVED_TILE_COLOR_BUFFER_EXTENDED, store) {
+                        store.disable_color_buffer_write = 0xff;
+                        store.disable_color_buffers_clear_on_write = true;
+                        store.disable_z_buffer_clear_on_write = true;
+                        store.disable_stencil_buffer_clear_on_write = true;
+                        /* END_OF_RENDERING terminates the frame. */
+                        store.last_tile_of_frame = false;
+                }
+                cl_emit(&rcl, END_OF_RENDERING, end);
+                uint32_t record[] = {
+                        0x80, 0x10000, 0, (code->offset + cs->offset) | 4,
+                        uniforms.bo->offset + uniforms.offset, 0,0,0,0,
+                        cl->offset + 0x800, 0x2096, 4,
+                        cl->offset + 0x900, 0x209a, 0,
+                };
+                memcpy(map + 0x400, record, sizeof(record));
+                uint16_t *xy = (void *)(map + 0x800);
+                for (unsigned i = 0; i < groups; i++) {
+                        xy[i*4] = 128; xy[i*4+1] = 256 + 512*i;
+                        xy[i*4+2] = 64*256+128; xy[i*4+3] = 256 + 512*i;
+                }
+                uint32_t zw[] = {0, 0x3f800000};
+                memcpy(map + 0x900, zw, sizeof(zw));
+                job->submit.rcl_start = cl->offset;
+                job->submit.rcl_end = cl->offset + ((uint8_t *)rcl.next - map);
+                job->submit.flags = DRM_V3D_SUBMIT_CL_FLUSH_CACHE;
+                job->submit.in_sync_rcl = v3d->out_sync;
+                job->submit.out_sync = v3d->out_sync;
+                int ret = v3d_ioctl(screen->fd, DRM_IOCTL_V3D_SUBMIT_CL,
+                                    &job->submit);
+                if (ret)
+                        fprintf(stderr, "compute33 submit: %s\n", strerror(errno));
+                v3d_job_free(v3d, job);
+                v3d_bo_unreference(&uniforms.bo);
+                v3d_bo_unreference(&cl);
+                v3d_bo_unreference(&ids);
+                v3d_bo_unreference(&color);
+                if (ret)
+                        break;
+        }
+        u_foreach_bit(i, v3d->ssbo[PIPE_SHADER_COMPUTE].enabled_mask) {
+                struct v3d_resource *rsc = v3d_resource(
+                        v3d->ssbo[PIPE_SHADER_COMPUTE].sb[i].buffer);
+                rsc->writes++;
+                rsc->compute_written = true;
+        }
+        u_foreach_bit(i, v3d->shaderimg[PIPE_SHADER_COMPUTE].enabled_mask) {
+                struct v3d_resource *rsc = v3d_resource(
+                        v3d->shaderimg[PIPE_SHADER_COMPUTE].si[i].base.resource);
+                rsc->writes++;
+                rsc->compute_written = true;
+        }
+        v3d->sync_on_last_compute_job = true;
+        v3d->dirty = ~0;
+}
+#endif
+
 #if V3D_VERSION >= 41
 #define V3D_CSD_CFG012_WG_COUNT_SHIFT 16
 #define V3D_CSD_CFG012_WG_OFFSET_SHIFT 0
@@ -1795,6 +1978,10 @@ v3dX(draw_init)(struct pipe_context *pctx)
         pctx->clear = v3d_clear;
         pctx->clear_render_target = v3d_clear_render_target;
         pctx->clear_depth_stencil = v3d_clear_depth_stencil;
+#if V3D_VERSION == 33
+        if (v3d_context(pctx)->screen->has_compute33)
+                pctx->launch_grid = v3d33_launch_grid;
+#endif
 #if V3D_VERSION >= 41
         if (v3d_context(pctx)->screen->has_csd)
                 pctx->launch_grid = v3d_launch_grid;
