@@ -289,6 +291,35 @@ v3d_write_uniforms(struct v3d_context *v3d, struct v3d_job *job,
         struct v3d_uniform_list *uinfo = &shader->prog_data.base->uniforms;
         const uint32_t *gallium_uniforms = cb->cb[0].user_buffer;
 
+        /* Emit descriptors before reserving the uniform stream: allocating
+         * them while writing uniforms could move the indirect BO.
+         */
+        struct v3d_cl_reloc gather_state[PIPE_MAX_SAMPLERS][8] = {0};
+        if (devinfo->ver == 33) {
+                if (stage == PIPE_SHADER_COMPUTE) {
+                        for (unsigned unit = 0; unit < texstate->num_textures; unit++) {
