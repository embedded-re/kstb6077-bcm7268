+                                        continue;
+                                struct v3d_cl_reloc state = v3d33_emit_texture_state(
+                                        v3d, job, texstate, unit, -1);
+                                texstate->texture_state[unit].offset = state.offset;
+                                v3d_bo_set_reference(&texstate->texture_state[unit].bo,
+                                                     state.bo);
+                        }
+                }
+                for (unsigned i = 0; i < uinfo->count; i++) {
+                        uint32_t data = uinfo->data[i];
+                        if (uinfo->contents[i] != QUNIFORM_TEXTURE_CONFIG_P1 ||
+                            !(data & V3D33_TEXTURE_P1_GATHER))
+                                continue;
+                        unsigned unit = (data >> 5) & 0x1f;
+                        unsigned component = (data >> V3D33_TEXTURE_P1_COMPONENT_SHIFT) & 7;
+                        if (!gather_state[unit][component].bo)
+                                gather_state[unit][component] = v3d33_emit_texture_state(
+                                        v3d, job, texstate, unit, component);
