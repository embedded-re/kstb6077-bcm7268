+                    sampler->target != PIPE_TEXTURE_CUBE_ARRAY &&
+                    (sampler->format == PIPE_FORMAT_Z32_FLOAT ||
+                     sampler->format == PIPE_FORMAT_Z32_FLOAT_S8X24_UINT))
+                        key->sampler[i].gather_compare = sampler_state->compare_func + 1;
+
                 /* For 16-bit, we set up the sampler to always return 2
                  * channels (meaning no recompiles for most statechanges),
                  * while for 32 we actually scale the returns with channels.
diff --git a/src/gallium/drivers/v3d/v3d_screen.c b/src/gallium/drivers/v3d/v3d_screen.c
