+                unpacked.filter = V3D_TMU_FILTER_MIN_LIN_MIP_NONE_MAG_LIN;
+                unpacked.min_level_of_detail = psview->u.tex.first_level;
+                unpacked.max_level_of_detail = psview->u.tex.first_level;
+                unsigned swizzle = return_size == 32 ? gather_component :
