         else if (psampler->max_anisotropy)
                 unpacked.filter = V3D_TMU_FILTER_ANISOTROPIC_2_1;
 
+        if (gather_component >= 0) {
+                /* Gather needs the four neighbors of a linear footprint even
+                 * when the application's sampler uses nearest filtering.
