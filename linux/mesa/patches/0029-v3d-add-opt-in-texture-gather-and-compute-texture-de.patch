+        bool raw_gather = gather_component >= 4;
+        if (raw_gather)
+                gather_component &= 3;
         struct pipe_sampler_state *psampler = stage_tex->samplers[i];
         struct v3d_sampler_state *sampler = v3d_sampler_state(psampler);
