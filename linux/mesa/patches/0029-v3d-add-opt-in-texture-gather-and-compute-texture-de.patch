          * we have to rescale from ([0, width], [0, height]) to ([0, 1], [0,
diff --git a/src/broadcom/compiler/v3d_compiler.h b/src/broadcom/compiler/v3d_compiler.h
index aa48daf..b7f42fc 100644
--- a/src/broadcom/compiler/v3d_compiler.h
+++ b/src/broadcom/compiler/v3d_compiler.h
@@ -406,6 +406,7 @@ struct v3d_key {
         struct {
                 uint8_t return_size;
                 uint8_t return_channels;
+                uint8_t gather_compare; /* PIPE_FUNC + 1, zero for native compare */
         } sampler[V3D_MAX_TEXTURE_SAMPLERS];
 
         uint8_t num_tex_used;
@@ -936,6 +937,15 @@ struct v3d_compile {
         bool has_global_address;
 };
 
+/* Software metadata in a 3.3 texture P1 uniform: bits 0..4 are the
+ * hardware return mask and bits 5..9 identify the texture unit. Gather
+ * requests select a separate descriptor for the requested component; bit 19
+ * selects raw F32 depths for a QPU shadow comparison.
+ */
+#define V3D33_TEXTURE_P1_GATHER (1u << 16)
+#define V3D33_TEXTURE_P1_COMPONENT_SHIFT 17
+#define V3D33_TEXTURE_P1_GATHER_COMPARE (1u << 19)
+
 struct v3d_uniform_list {
         enum quniform_contents *contents;
         uint32_t *data;
diff --git a/src/broadcom/compiler/vir.c b/src/broadcom/compiler/vir.c
index 4d66df4..b809925 100644
--- a/src/broadcom/compiler/vir.c
+++ b/src/broadcom/compiler/vir.c
@@ -637,6 +637,34 @@ lower_tex_packing_cb(const nir_tex_instr *tex, const void *data)
       nir_lower_tex_packing_16 : nir_lower_tex_packing_none;
 }
 
+/* The 3.3 native F32 gather comparison does not preserve infinite border
+ * depths. Gather raw depths through the TMU and compare on the QPUs instead.
+ */
+static bool
+v3d33_lower_gather_compare(nir_builder *b, nir_instr *instr, void *data)
+{
+        struct v3d_compile *c = data;
+        if (instr->type != nir_instr_type_tex)
+                return false;
+        nir_tex_instr *tex = nir_instr_as_tex(instr);
+        unsigned compare = c->key->sampler[tex->texture_index].gather_compare;
+        if (tex->op != nir_texop_tg4 || !tex->is_shadow || !compare)
+                return false;
+
+        int comparator = nir_tex_instr_src_index(tex, nir_tex_src_comparator);
+        nir_def *reference = tex->src[comparator].src.ssa;
+        tex->is_shadow = false;
+        tex->is_new_style_shadow = false;
+        nir_tex_instr_remove_src(tex, comparator);
+        b->cursor = nir_after_instr(instr);
+        nir_def *result = nir_b2f32(b, nir_compare_func(
+                b, (enum compare_func)(compare - 1), reference, &tex->def));
+        if (result->num_components == 1)
+                result = nir_vec4(b, result, result, result, result);
+        nir_def_rewrite_uses_after(&tex->def, result, result->parent_instr);
+        return true;
+}
+
 static void
 v3d_lower_nir(struct v3d_compile *c)
 {
@@ -664,6 +692,11 @@ v3d_lower_nir(struct v3d_compile *c)
         tex_options.lower_tex_packing_cb = lower_tex_packing_cb;
         tex_options.lower_tex_packing_data = c;
 
+        if (c->devinfo->ver == 33)
+                NIR_PASS(_, c->s, nir_shader_instructions_pass,
+                         v3d33_lower_gather_compare,
+                         nir_metadata_block_index | nir_metadata_dominance, c);
+
         NIR_PASS(_, c->s, nir_lower_tex, &tex_options);
         NIR_PASS(_, c->s, nir_lower_system_values);
 
