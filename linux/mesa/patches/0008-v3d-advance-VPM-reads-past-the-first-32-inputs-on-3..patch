From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: 1q9lugp <lackowork84@gmail.com>
Date: Wed, 21 Oct 2026 11:58:15 +0200
Subject: [PATCH 08/17] v3d: advance VPM reads past the first 32 inputs on 3.3

ntq_emit_vpm_read() restarted at zero after the first batch; large
matrix/array captures read the wrong inputs.
---
 src/broadcom/compiler/nir_to_vir.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/src/broadcom/compiler/nir_to_vir.c b/src/broadcom/compiler/nir_to_vir.c
index 0da5400..1deb315 100644
--- a/src/broadcom/compiler/nir_to_vir.c
+++ b/src/broadcom/compiler/nir_to_vir.c
@@ -2204,12 +2204,14 @@ ntq_emit_vpm_read(struct v3d_compile *c,
         struct qreg vpm = vir_reg(QFILE_VPM, vpm_index);
         if (*num_components_queued != 0) {
                 (*num_components_queued)--;
+                c->num_inputs++;
                 return vir_MOV(c, vpm);
         }
 
         uint32_t num_components = MIN2(*remaining, 32);
 
         v3d33_vir_vpm_read_setup(c, num_components);
+        c->num_inputs++;
 
         *num_components_queued = num_components - 1;
         *remaining -= num_components;
