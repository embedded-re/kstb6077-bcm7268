From: 1q9lugp <lackowork84@gmail.com>
Date: Sun, 25 Oct 2026 20:11:50 +0100
Subject: [PATCH 34/34] v3d: retry vertex TMU spills with one thread on V3D 3.3

---
 src/broadcom/compiler/vir_register_allocate.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/src/broadcom/compiler/vir_register_allocate.c b/src/broadcom/compiler/vir_register_allocate.c
index 90c6c2f..bc9645b 100644
--- a/src/broadcom/compiler/vir_register_allocate.c
+++ b/src/broadcom/compiler/vir_register_allocate.c
@@ -1122,6 +1122,14 @@ vir_init_reg_sets(struct v3d_compiler *compiler)
 static inline bool
 tmu_spilling_allowed(struct v3d_compile *c)
 {
+        /* Threaded vertex TMU spills hang V3D 3.3 on WebRender shaders.
+         * Let register allocation retry with one thread and its larger RF
+         * instead. Keep threading for shaders that do not need TMU spills.
+         */
+        if (c->devinfo->ver == 33 &&
+            c->s->info.stage == MESA_SHADER_VERTEX && c->threads > 1)
+                return false;
+
         return c->spills + c->fills < c->max_tmu_spills;
 }
 
