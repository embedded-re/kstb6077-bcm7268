                 c->has_general_tmu_load = true;
                 break;
 
+        case nir_intrinsic_image_texel_address:
+                assert(c->devinfo->ver == 33);
+                v3d33_vir_emit_image_address(c, instr);
+                break;
+
+        case nir_intrinsic_image_samples:
