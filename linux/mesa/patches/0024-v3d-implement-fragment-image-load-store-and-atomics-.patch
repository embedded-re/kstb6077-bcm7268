+static struct qreg
+image_select_tiling(struct v3d_compile *c, struct qreg tiling, unsigned mode,
+                    struct qreg match, struct qreg other)
+{
+        vir_set_pf(c, vir_SUB_dest(c, vir_nop_reg(), tiling,
+                                   vir_uniform_ui(c, mode)), V3D_QPU_PF_PUSHZ);
+        return vir_MOV(c, vir_SEL(c, V3D_QPU_COND_IFA, match, other));
+}
+
+void
+v3d33_vir_emit_image_address(struct v3d_compile *c, nir_intrinsic_instr *intr)
+{
+        unsigned unit = nir_src_as_uint(intr->src[0]);
+        unsigned cpp = util_format_get_blocksize(nir_intrinsic_format(intr));
+        unsigned log_cpp = util_logbase2(cpp);
+        unsigned log_uw = cpp <= 2 ? 3 : cpp <= 8 ? 2 : 1;
+        unsigned log_uh = cpp == 1 ? 3 : cpp <= 4 ? 2 : 1;
+        enum glsl_sampler_dim dim = nir_intrinsic_image_dim(intr);
+        bool array = nir_intrinsic_image_array(intr);
+        struct qreg zero = vir_uniform_ui(c, 0);
+        struct qreg x = ntq_get_src(c, intr->src[1], 0);
+        struct qreg y = (dim == GLSL_SAMPLER_DIM_1D || dim == GLSL_SAMPLER_DIM_BUF) ?
+                        zero : ntq_get_src(c, intr->src[1], 1);
+        struct qreg z = zero;
+        if (dim == GLSL_SAMPLER_DIM_3D || dim == GLSL_SAMPLER_DIM_CUBE ||
+            (array && dim != GLSL_SAMPLER_DIM_1D))
+                z = ntq_get_src(c, intr->src[1], 2);
+        else if (array)
+                z = ntq_get_src(c, intr->src[1], 1);
+        if (dim == GLSL_SAMPLER_DIM_MS) {
+                struct qreg sample = ntq_get_src(c, intr->src[2], 0);
+                x = vir_ADD(c, vir_SHL(c, x, vir_uniform_ui(c, 1)),
+                            vir_AND(c, sample, vir_uniform_ui(c, 1)));
+                y = vir_ADD(c, vir_SHL(c, y, vir_uniform_ui(c, 1)),
+                            vir_AND(c, vir_SHR(c, sample, vir_uniform_ui(c, 1)),
+                                    vir_uniform_ui(c, 1)));
+        }
+        struct qreg tiling = vir_uniform(c, QUNIFORM_IMAGE_TILING, unit);
+        struct qreg base = vir_uniform(c, QUNIFORM_IMAGE_BASE, unit);
+        struct qreg stride = vir_uniform(c, QUNIFORM_IMAGE_STRIDE, unit);
+        struct qreg layer_stride = vir_uniform(c, QUNIFORM_IMAGE_LAYER_STRIDE, unit);
+        struct qreg height = vir_uniform(c, QUNIFORM_IMAGE_PADDED_HEIGHT, unit);
+
+        struct qreg in_utile = vir_ADD(c,
+                vir_SHL(c, vir_AND(c, x, vir_uniform_ui(c, (1u << log_uw) - 1)),
+                        vir_uniform_ui(c, log_cpp)),
+                vir_SHL(c, vir_AND(c, y, vir_uniform_ui(c, (1u << log_uh) - 1)),
+                        vir_uniform_ui(c, log_uw + log_cpp)));
+        struct qreg lt = vir_ADD(c, in_utile,
+                vir_SHL(c, vir_ADD(c,
+                        vir_SHR(c, x, vir_uniform_ui(c, log_uw)),
+                        vir_SHR(c, y, vir_uniform_ui(c, log_uh))),
+                        vir_uniform_ui(c, 6)));
+        struct qreg in_uif = vir_ADD(c, in_utile,
+                vir_ADD(c,
+                        vir_SHL(c, vir_AND(c, vir_SHR(c, x, vir_uniform_ui(c, log_uw)),
+                                          vir_uniform_ui(c, 1)), vir_uniform_ui(c, 6)),
+                        vir_SHL(c, vir_AND(c, vir_SHR(c, y, vir_uniform_ui(c, log_uh)),
+                                          vir_uniform_ui(c, 1)), vir_uniform_ui(c, 7))));
+        struct qreg bx = vir_SHR(c, x, vir_uniform_ui(c, log_uw + 1));
+        struct qreg by = vir_SHR(c, y, vir_uniform_ui(c, log_uh + 1));
+        struct qreg ub1 = vir_ADD(c, in_uif,
+                vir_SHL(c, vir_ADD(c, bx, by), vir_uniform_ui(c, 8)));
+        struct qreg ub2 = vir_ADD(c, in_uif,
+                vir_SHL(c, vir_ADD(c, bx, vir_SHL(c, by, vir_uniform_ui(c, 1))),
+                        vir_uniform_ui(c, 8)));
+        struct qreg xor_y = vir_XOR(c, by,
+                vir_SHL(c, vir_AND(c, bx, vir_uniform_ui(c, 4)), vir_uniform_ui(c, 2)));
+        struct qreg uif_y = image_select_tiling(c, tiling, V3D_TILING_UIF_XOR, xor_y, by);
+        struct qreg uif_height = vir_SHR(c, height, vir_uniform_ui(c, log_uh + 1));
+        struct qreg block = vir_ADD(c,
+                vir_UMUL(c, vir_SHR(c, bx, vir_uniform_ui(c, 2)),
+                         vir_SHL(c, uif_height, vir_uniform_ui(c, 2))),
+                vir_ADD(c, vir_AND(c, bx, vir_uniform_ui(c, 3)),
+                           vir_SHL(c, uif_y, vir_uniform_ui(c, 2))));
+        struct qreg offset = vir_ADD(c, in_uif, vir_SHL(c, block, vir_uniform_ui(c, 8)));
+        struct qreg raster = vir_ADD(c, vir_SHL(c, x, vir_uniform_ui(c, log_cpp)),
+                                      vir_UMUL(c, y, stride));
+        offset = image_select_tiling(c, tiling, V3D_TILING_UBLINEAR_2_COLUMN, ub2, offset);
+        offset = image_select_tiling(c, tiling, V3D_TILING_UBLINEAR_1_COLUMN, ub1, offset);
+        offset = image_select_tiling(c, tiling, V3D_TILING_LINEARTILE, lt, offset);
+        offset = image_select_tiling(c, tiling, V3D_TILING_RASTER, raster, offset);
+        struct qreg address = vir_ADD(c, base,
+                vir_ADD(c, offset, vir_UMUL(c, z, layer_stride)));
+        ntq_store_def(c, &intr->def, 0, address);
+}
