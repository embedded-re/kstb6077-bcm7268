+/* 3.3 images use ordinary TMU memory accesses. The texel-address intrinsic
+ * retains the image index and coordinates until VIR can load the resource's
+ * actual tiling parameters from uniforms.
+ */
+static nir_def *
+v3d33_unpack_image(nir_builder *b, nir_def *raw, enum pipe_format format)
+{
+        const struct util_format_description *desc = util_format_description(format);
+        const struct util_format_channel_description *chan = &desc->channel[0];
+        unsigned count = util_format_get_nr_components(format);
+        unsigned bits[4];
+        for (unsigned i = 0; i < count; i++)
+                bits[i] = desc->channel[i].size;
+
+        nir_def *value;
+        if (format == PIPE_FORMAT_R11G11B10_FLOAT) {
+                value = nir_format_unpack_11f11f10f(b, raw);
+        } else if (chan->size == 32) {
+                value = raw;
+        } else {
+                if (chan->type == UTIL_FORMAT_TYPE_SIGNED)
+                        value = nir_format_unpack_sint(b, raw, bits, count);
+                else
+                        value = nir_format_unpack_uint(b, raw, bits, count);
+
+                if (chan->normalized) {
+                        value = chan->type == UTIL_FORMAT_TYPE_SIGNED ?
+                                nir_format_snorm_to_float(b, value, bits) :
+                                nir_format_unorm_to_float(b, value, bits);
+                } else if (chan->type == UTIL_FORMAT_TYPE_FLOAT) {
+                        assert(chan->size == 16);
+                        value = nir_unpack_half_2x16_split_x(b, value);
+                }
+        }
+
+        nir_def *components[4];
+        for (unsigned i = 0; i < 4; i++) {
+                if (i < count)
+                        components[i] = nir_channel(b, value, i);
+                else if (i == 3)
+                        components[i] = chan->pure_integer ? nir_imm_int(b, 1) :
+                                                           nir_imm_float(b, 1.0f);
+                else
+                        components[i] = nir_imm_int(b, 0);
+        }
+        return nir_vec4(b, components[0], components[1], components[2], components[3]);
+}
+
+static bool
+v3d33_lower_image(nir_builder *b, nir_intrinsic_instr *intr, void *data)
+{
+        bool load = intr->intrinsic == nir_intrinsic_image_load;
+        bool store = intr->intrinsic == nir_intrinsic_image_store;
+        bool atomic = intr->intrinsic == nir_intrinsic_image_atomic;
+        bool swap = intr->intrinsic == nir_intrinsic_image_atomic_swap;
+        if (!load && !store && !atomic && !swap)
+                return false;
+
+        enum pipe_format format = nir_intrinsic_format(intr);
+        assert(format != PIPE_FORMAT_NONE);
+        unsigned cpp = util_format_get_blocksize(format);
+        assert(util_is_power_of_two_nonzero(cpp) && cpp <= 16);
+        enum glsl_sampler_dim dim = nir_intrinsic_image_dim(intr);
+        bool array = nir_intrinsic_image_array(intr);
+        unsigned coords = nir_image_intrinsic_coord_components(intr);
+        unsigned size_components = coords - (dim == GLSL_SAMPLER_DIM_CUBE && !array);
+
+        if (store)
+                v3d_nir_lower_image_store(b, intr);
+        b->cursor = nir_before_instr(&intr->instr);
+        nir_def *size = nir_image_size(b, size_components, 32, intr->src[0].ssa,
+                                       nir_imm_int(b, 0), .image_dim = dim,
+                                       .image_array = array);
+        if (dim == GLSL_SAMPLER_DIM_CUBE) {
+                nir_def *layers = array ? nir_imul_imm(b, nir_channel(b, size, 2), 6) :
+                                         nir_imm_int(b, 6);
+                size = nir_vec3(b, nir_channel(b, size, 0), nir_channel(b, size, 1), layers);
+        }
+        nir_def *coord = nir_trim_vector(b, intr->src[1].ssa, coords);
+        nir_def *valid = nir_ball(b, nir_ult(b, coord, size));
+        /* Address computation is outside the conditional so discarded lanes
+         * also have valid addresses for the store-only thread-switch read.
+         * Clamping affects only that address, not out-of-bounds semantics.
+         */
+        nir_def *limit = nir_iadd_imm(b, nir_umax(b, size, nir_imm_int(b, 1)), -1);
+        nir_def *safe = nir_umin(b, coord, limit);
+        nir_def *c[4];
+        for (unsigned i = 0; i < 4; i++)
+                c[i] = i < coords ? nir_channel(b, safe, i) : nir_imm_int(b, 0);
+        nir_def *sample = nir_imm_int(b, 0);
+        if (dim == GLSL_SAMPLER_DIM_MS) {
+                nir_def *samples = nir_image_samples(b, 32, intr->src[0].ssa,
+                                                      .image_dim = dim,
+                                                      .image_array = array);
+                sample = intr->src[2].ssa;
+                valid = nir_iand(b, valid, nir_ult(b, sample, samples));
+                sample = nir_umin(b, sample,
+                                  nir_iadd_imm(b, nir_umax(b, samples, nir_imm_int(b, 1)), -1));
+        }
+        nir_def *addr = nir_image_texel_address(b, 32, intr->src[0].ssa,
+                        nir_vec4(b, c[0], c[1], c[2], c[3]), sample,
+                        .image_dim = dim, .image_array = array, .format = format,
+                        .access = nir_intrinsic_access(intr));
+        nir_def *address = nir_vec2(b, addr, nir_imm_int(b, 0));
+        enum gl_access_qualifier access = nir_intrinsic_access(intr);
+        unsigned raw_bits = cpp < 4 ? cpp * 8 : 32;
+        unsigned raw_components = DIV_ROUND_UP(cpp, 4);
+        nir_def *result = NULL;
+        nir_def *zero = store ? NULL : nir_imm_zero(b, load ? 4 : 1, 32);
+        nir_push_if(b, valid);
+        if (load) {
+                nir_def *raw = nir_load_global_2x32(b, raw_components, raw_bits, address,
+                                                   .align_mul = MIN2(cpp, 4),
+                                                   .access = access);
+                if (raw_bits < 32)
+                        raw = nir_u2u32(b, raw);
+                result = v3d33_unpack_image(b, raw, format);
+        } else if (store) {
+                nir_def *value = intr->src[3].ssa;
+                if (raw_bits < 32)
+                        value = nir_u2uN(b, value, raw_bits);
+                nir_store_global_2x32(b, value, address,
+                                      .write_mask = BITFIELD_MASK(raw_components),
+                                      .align_mul = MIN2(cpp, 4), .access = access);
+        } else if (atomic) {
+                result = nir_global_atomic_2x32(b, 32, address, intr->src[3].ssa,
+                                                .atomic_op = nir_intrinsic_atomic_op(intr));
+        } else {
+                result = nir_global_atomic_swap_2x32(b, 32, address, intr->src[3].ssa,
+                             intr->src[4].ssa, .atomic_op = nir_intrinsic_atomic_op(intr));
+        }
+        nir_pop_if(b, NULL);
+        if (!store) {
+                result = nir_if_phi(b, result, zero);
+                nir_def_rewrite_uses(&intr->def, result);
+        }
+        nir_instr_remove(&intr->instr);
+        return true;
+}
+
+bool
+v3d33_nir_lower_image_load_store(nir_shader *s)
+{
+        return nir_shader_intrinsics_pass(s, v3d33_lower_image, nir_metadata_none, NULL);
+}
