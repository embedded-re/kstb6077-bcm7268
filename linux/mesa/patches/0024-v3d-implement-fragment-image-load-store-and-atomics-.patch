@@ -4611,6 +4625,20 @@ vir_emit_last_thrsw(struct v3d_compile *c,
 {
         *restore_last_thrsw = c->last_thrsw;
 
+        if (c->devinfo->ver == 33 && c->threads > 1 && c->last_thrsw &&
+            !c->last_thrsw_at_top_level) {
+                /* A conditional access may not run in every thread. Issue
+                 * a harmless read in uniform control flow so every thread
+                 * can execute the final switch, including discarded lanes.
+                 */
+                struct qinst *read = vir_MOV_dest(c,
+                        vir_reg(QFILE_MAGIC, V3D_QPU_WADDR_TMUA),
+                        vir_uniform(c, QUNIFORM_TMU_DUMMY_ADDRESS, 0));
