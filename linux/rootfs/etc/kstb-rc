#!/bin/sh
# kstb-rc - start-up for both the initramfs and the root file system on ROOT
# (mmcblk0p8), then the shells from inittab
mountpoint -q /proc || mount -t proc proc /proc
# On ROOT the kernel mounts / read-only (kstb6077-root.dtb: ro): check it
# first, fsck -p repairs what is safe (after a reset without unmounting).
# If it changed anything, reboot (to kmon) rather than run on it.
root=
for a in $(cat /proc/cmdline); do
	case $a in root=*) root=${a#root=} ;; esac
done
if [ -b "$root" ] && [ -x /sbin/fsck.ext4 ]; then
	# /proc/mounts names it /dev/root: without that node e2fsck doesn't see
	# that it is mounted read-only, opens it exclusively and fails (busy)
	[ -e /dev/root ] || ln -s "${root#/dev/}" /dev/root
	fsck.ext4 -p "$root"
	r=$?
	if [ $r -ge 4 ]; then
		echo "kstb-rc: fsck.ext4 -p $root: exit $r, not repaired: boot the initramfs and run fsck.ext4 -f -y $root"
	elif [ $r -ge 2 ]; then
		echo "kstb-rc: fsck repaired $root; rebooting"
		sleep 2
		reboot -f
	fi
fi
mount -o remount,rw / 2>/dev/null
mountpoint -q /sys || mount -t sysfs sysfs /sys
mountpoint -q /dev || mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts && mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /tmp
mount -t debugfs debugfs /sys/kernel/debug
hostname kstb6077
# modules (kstb-modules): load the ones whose devices are there (device tree,
# PCI, USB), by their modalias
for a in $(sort -u /sys/bus/*/devices/*/modalias 2>/dev/null); do
	case $a in usb:v0A5Cp2045*) continue ;; esac	# Bluetooth: bt_patch below
	modprobe -q "$a"
done
# Bluetooth (BCM43569A2 on USB, 0a5c:2045): btbcm sends the patch at every
# probe, but Launch RAM makes this chip drop off USB and come back already
# patched, so it would be patched again, endlessly. Offer the patch file for
# one probe only: in place, reload btusb, wait for the chip to leave, remove it.
bt_patch() {
	src=/lib/firmware/kstb/BCM43569.hcd
	fw=/lib/firmware/brcm/BCM-0a5c-2045.kaon,kstb6077.hcd
	for d in /sys/bus/usb/devices/*; do
		[ "$(cat $d/idVendor 2>/dev/null):$(cat $d/idProduct 2>/dev/null)" = 0a5c:2045 ] && break
		d=
	done
	[ -n "$d" ] && [ -f "$src" ] || return 0
	modprobe -r btusb
	cp "$src" "$fw"
	modprobe btusb || { rm -f "$fw"; return 0; }
	i=0
	while [ -e "$d" ] && [ $i -lt 50 ]; do sleep 0.1; i=$((i + 1)); done
	rm -f "$fw"
}
(bt_patch &)
echo "kstb6077: $(uname -r), $(grep -c ^processor /proc/cpuinfo) cores, $(sed -n 's/MemTotal: *//p' /proc/meminfo), root $(awk '$2 == "/" {print $1}' /proc/mounts | tail -1)"
ip link set lo up
if ip link set eth0 up 2>/dev/null; then
	udhcpc -i eth0 -b -q -t 5 >/dev/null 2>&1 && echo "eth0: $(ip -4 -o addr show eth0 | awk '{print $4}')"
	# no RTC is used: set the clock from the network (TLS for apk needs it)
	(ntpd -n -q -p pool.ntp.org >/dev/null 2>&1 &)
fi
