#!/bin/sh
# kstb-modules - fetch the modules for the running kernel from the PC's TFTP
# root (make -C linux tftp puts linux-modules.tar there) into /lib/modules.
#   kstb-modules [server]      default 192.168.1.38
# Needs busybox-extras (tftp). The modules must come from the same build as
# the kernel: run it after every kernel update.
set -e
server=${1:-192.168.1.38}
rel=$(uname -r)
busybox-extras tftp -g -r linux-modules.tar -l /tmp/modules.tar "$server"
tar tf /tmp/modules.tar "./$rel/modules.dep" >/dev/null || { echo "kstb-modules: no modules for $rel in it"; exit 1; }
rm -rf "/lib/modules/$rel"
mkdir -p /lib/modules
tar xf /tmp/modules.tar -C /lib/modules
rm /tmp/modules.tar
depmod -a
echo "/lib/modules/$rel: $(find "/lib/modules/$rel" -name '*.ko*' | wc -l) modules"
