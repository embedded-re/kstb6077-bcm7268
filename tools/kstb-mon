#!/usr/bin/env python3
"""Start kmon (the monitor, mon/) from the BOLT> prompt.

    kstb-mon                 WAD + bundle from flash0.splash, go -64 0x00100000
    kstb-mon --tftp          bundle by TFTP instead (test a new build without flashing)
    kstb-mon --install       TFTP the bundle, write it to flash0.splash, check, then start

The bundle (mon/build/kmon.img) = the monitor + doom.bin; it lives in
flash0.splash at +0xf00000, after the WAD (+0x100000). By hand, from BOLT>:

    load -raw -rawfs -offset=0xf00000 -addr=0x00100000 -max=0x1c0000 flash0.splash
    go -64 0x00100000

(kmon's `doom` reads the WAD from the eMMC itself; this tool also has BOLT
load it first, which is just as fast.)

--tftp/--install need a TFTP server whose root holds kmon.img (docs/booting.md).
--install writes only flash0.splash +0xf00000 ... +0xf00000 + size.
"""
import argparse, importlib.machinery, importlib.util, os, re, sys, zlib

here = os.path.dirname(os.path.abspath(__file__))
_loader = importlib.machinery.SourceFileLoader("kstb_run", os.path.join(here, "kstb-run"))
kstb_run = importlib.util.module_from_spec(importlib.util.spec_from_loader("kstb_run", _loader))
_loader.exec_module(kstb_run)

IMG = os.path.join(here, "..", "mon", "build", "kmon.img")
WAD_LOAD = "load -raw -rawfs -offset=0x100000 -addr=0x10000000 -max=0xdc7000 flash0.splash"
BUNDLE_OFF, BUNDLE_MAX = 0xf00000, 0x1c0000
STAGE = 0x12000000          # above BOLT's flash staging buffer 0x00040000 + 16 MB


def run(b, line, timeout=30):
    out, st = b.cmd(line, timeout)
    if st is None or st < 0:
        raise SystemExit(f"failed: {line}\n{out}")
    print(f"ok: {line}")
    return out


def crc_on_board(b, addr, size):
    out, _ = b.cmd(f"crc -offset=0x{addr:x} -size=0x{size:x}")
    m = re.search(r"=\s+0x([0-9a-f]+)", out)
    return int(m.group(1), 16) if m else None


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--tftp", action="store_true", help="load the bundle by TFTP, not from flash")
    ap.add_argument("--install", action="store_true", help="TFTP the bundle and write it to flash first")
    ap.add_argument("--server", default="192.168.1.38", help="TFTP server address")
    ap.add_argument("--file", default="kmon.img", help="file name on the TFTP server")
    ap.add_argument("--watchdog", type=int, metavar="S", help="arm the watchdog before go (kmon: `wdt off`)")
    ap.add_argument("--listen", type=float, default=4, help="seconds to print output after go")
    a = ap.parse_args()

    b = kstb_run.Board(kstb_run.SOCK)
    img = open(IMG, "rb").read() if (a.tftp or a.install) else None
    if img and len(img) > BUNDLE_MAX:
        raise SystemExit(f"bundle too big: {len(img)} > {BUNDLE_MAX}")

    if a.tftp or a.install:
        run(b, "ifconfig eth0 -auto")
        dest = STAGE if a.install else 0x00100000
        run(b, f"load -raw -addr=0x{dest:x} -tftp {a.server}:{a.file}", 60)
        if crc_on_board(b, dest, len(img)) != zlib.crc32(img):
            raise SystemExit("CRC MISMATCH after TFTP (stale file? is the TFTP root's kmon.img the new build?)")
        print(f"bundle CRC OK 0x{zlib.crc32(img):08x} ({len(img)} bytes)")
    if a.install:
        run(b, f"flash -noerase -offset=0x{BUNDLE_OFF:x} -mem=0x{STAGE:x} -memsize=0x{len(img):x} mem0 flash0.splash", 60)
        run(b, f"load -raw -rawfs -offset=0x{BUNDLE_OFF:x} -addr=0x{STAGE + 0x400000:x} -max=0x{len(img):x} flash0.splash")
        if crc_on_board(b, STAGE + 0x400000, len(img)) != zlib.crc32(img):
            raise SystemExit("CRC MISMATCH on flash read-back")
        print("flash read-back CRC OK")

    run(b, WAD_LOAD)
    if not a.tftp:
        run(b, f"load -raw -rawfs -offset=0x{BUNDLE_OFF:x} -addr=0x00100000 -max=0x{BUNDLE_MAX:x} flash0.splash")
    if a.watchdog:
        ticks = a.watchdog * kstb_run.TICKS_PER_S
        if ticks > 0xffffffff:
            raise SystemExit("watchdog too long (max 159 s)")
        for line in (f"e -w 0xf040a6a8 {ticks:08x}", "e -w 0xf040a6ac 0000ff00", "e -w 0xf040a6ac 000000ff"):
            b.cmd(line)
        print(f"watchdog armed: {a.watchdog} s")
    print("--- go -64 0x00100000 ---")
    b.send_raw("go -64 0x00100000")
    b.stream(a.listen)
    print()


if __name__ == "__main__":
    main()
