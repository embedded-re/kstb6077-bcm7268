#!/usr/bin/env python3
"""Boot the KSTB6077 once without BOLT's splash, by sending Ctrl-S.

BOLT checks the console for boot keys right after its banner; Ctrl-S prints
"Splash screen disabled via Ctrl-S" and skips the splash for this boot only
(nothing is stored, the next boot has the splash again). Autostart still runs,
so kmon starts with no display and no audio DMA from BOLT, and sets both up
itself (mon/README.md, "Video").

    kstb-nosplash              wait for a boot (power-cycle the board now)
    kstb-nosplash --reset      board is at kmon>: reset it first
    kstb-nosplash --timeout 600

Needs the kstb-bridge service (socket /tmp/kstb.sock, override with KSTB_SOCK).
Exit status: 0 = splash skipped, 1 = the window was missed, 2 = timeout.
"""
import argparse, os, socket, sys, time

SOCK = os.environ.get("KSTB_SOCK", "/tmp/kstb.sock")
START = b"GO!"                          # BOLT's main code starts; its console reads keys from here on
SKIPPED = b"Splash screen disabled via Ctrl-S"
TOO_LATE = (b"CPU 4x", b"SPLASH: starting")


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--reset", action="store_true", help="board is at kmon>: reset it first")
    ap.add_argument("--timeout", type=float, default=300, help="seconds to wait for a boot (default 300)")
    a = ap.parse_args()

    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.connect(SOCK)
    s.settimeout(0.003)

    if a.reset:
        s.sendall(b"reset\r")
    else:
        print("waiting for the board to boot - power-cycle it now", flush=True)

    buf, end = b"", time.time() + a.timeout
    while time.time() < end:
        try:
            chunk = s.recv(65536)
            if chunk:
                buf += chunk
        except socket.timeout:
            pass
        if SKIPPED in buf:
            print("splash skipped for this boot (Ctrl-S)")
            return 0
        if any(t in buf for t in TOO_LATE):
            print("too late: BOLT got past its boot keys", file=sys.stderr)
            return 1
        if START in buf:
            s.sendall(b"\x13")          # Ctrl-S, continuously until BOLT reacts
    print("timeout: no boot seen", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
