#!/usr/bin/env python3
"""Render a monospaced font into a C header for the HDMI text console (mon/fbcon.c).

    make-font [--font F.otf] [--size PX] [--cell WxH] out.h

Printable ASCII (0x20-0x7e), one cell per glyph, 4-bit coverage per pixel
(two pixels per byte, left pixel in the low nibble), so the console can blend
anti-aliased text into the RGB565 framebuffer.

Default: Adobe Source Code Pro Medium (SIL Open Font License 1.1), as
installed by Arch's adobe-source-code-pro-fonts package. The OFL notice is
copied into the header.
"""
import argparse
from PIL import Image, ImageDraw, ImageFont

DEFAULT = "/usr/share/fonts/adobe-source-code-pro/SourceCodePro-Medium.otf"
NOTICE = ("Glyphs rendered from Source Code Pro, (c) 2023 Adobe (http://www.adobe.com/), "
          "with Reserved Font Name 'Source'. Licensed under the SIL Open Font License, "
          "Version 1.1: https://openfontlicense.org")


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("out")
    ap.add_argument("--font", default=DEFAULT)
    ap.add_argument("--size", type=int, default=26, help="font size in pixels")
    ap.add_argument("--cell", default="16x32", help="cell width x height")
    a = ap.parse_args()
    w, h = map(int, a.cell.split("x"))
    font = ImageFont.truetype(a.font, a.size)
    ascent, descent = font.getmetrics()
    top = (h - (ascent + descent)) // 2             # centre the line box in the cell

    lines = [f"// {a.out.split('/')[-1]} - generated by tools/make-font, do not edit.",
             f"// {a.font.split('/')[-1]}, {a.size} px, cell {w}x{h}, 4-bit coverage,",
             "// two pixels per byte (left pixel in the low nibble), ASCII 0x20-0x7e.",
             "//", f"// {NOTICE}", "",
             f"#define FONT_W {w}", f"#define FONT_H {h}", "",
             f"static const unsigned char font_glyphs[95][{w * h // 2}] = {{"]
    for ch in range(0x20, 0x7f):
        img = Image.new("L", (w, h), 0)
        d = ImageDraw.Draw(img)
        adv = font.getlength(chr(ch))
        d.text(((w - adv) / 2, top), chr(ch), font=font, fill=255)
        px = list(img.tobytes())
        nib = [(v * 15 + 127) // 255 for v in px]
        data = [nib[i] | nib[i + 1] << 4 for i in range(0, len(nib), 2)]
        body = ",".join(f"0x{b:02x}" for b in data)
        lines.append(f"    {{{body}}},  // {chr(ch)!r}")
    lines.append("};")
    open(a.out, "w").write("\n".join(lines) + "\n")


if __name__ == "__main__":
    main()
